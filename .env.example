# Copy to .env (never commit .env).

# The bot token: either put it here directly...
# DISCORD_TOKEN=
# ...or point at a file that contains it.
DISCORD_TOKEN_FILE=/path/to/discord-bot-token

# Comma-separated server IDs this instance serves.
# Dev (test server): 234567890123456789   Prod: 123456789012345678
GUILD_IDS=234567890123456789

# --- Game night reminder (leave both channel IDs unset to disable) ---
# Channel with the weekly announcement posts, and channel for the @everyone start message.
# GAME_NIGHT_ANNOUNCEMENTS_CHANNEL_ID=
# GAME_NIGHT_CHANNEL_ID=
# When sessions start (cron pattern) and in which timezone. These are the defaults:
# GAME_NIGHT_SCHEDULE=30 10 * * 6
# GAME_NIGHT_TIMEZONE=America/Los_Angeles

# --- Game suggestions (leave unset to disable) ---
# Forum channel where each post's title is a game name.
# GAME_SUGGESTIONS_CHANNEL_ID=
# IsThereAnyDeal API key, for deal info in game replies (optional). Use the "API key" from your app at
# isthereanydeal.com, not the OAuth client ID/secret. Either set it directly or point at a file.
# ITAD_API_KEY=
# ITAD_API_KEY_FILE=/path/to/itad-api-key
