# Copy to .env (never commit .env).

# The bot token: either put it here directly...
# DISCORD_TOKEN=
# ...or point at a file that contains it.
DISCORD_TOKEN_FILE=/path/to/discord-bot-token

# Comma-separated IDs of the servers this instance serves (right-click the server -> Copy Server ID,
# with Developer Mode on in Discord's Advanced settings).
GUILD_IDS=

# --- Game night reminder (leave both channel IDs unset to disable) ---
# Channel with the weekly announcement posts, and channel for the @everyone start message.
# GAME_NIGHT_ANNOUNCEMENTS_CHANNEL_ID=
# GAME_NIGHT_CHANNEL_ID=
# When sessions start (cron pattern) and in which timezone. These are the defaults:
# GAME_NIGHT_SCHEDULE=30 10 * * 6
# GAME_NIGHT_TIMEZONE=America/Los_Angeles
# Optional: a Claude API key (from platform.claude.com) lets the bot read announcements that don't
# follow the usual template, and research max players and mods for game suggestions.
# ANTHROPIC_API_KEY=
# ANTHROPIC_API_KEY_FILE=/path/to/anthropic-api-key
# The model must support the effort setting, e.g. any 5.x model (claude-haiku-4-5 and claude-sonnet-4-5 don't).
# CLAUDE_MODEL=claude-opus-5-5
# Optional: a Tavily API key (free plan, tavily.com) adds web search to that research.
# TAVILY_API_KEY=
# TAVILY_API_KEY_FILE=/path/to/tavily-api-key

# --- Game suggestions (leave unset to disable) ---
# Forum channel where each post's title is a game name.
# GAME_SUGGESTIONS_CHANNEL_ID=
# IsThereAnyDeal API key, for deal info in game replies (optional). Use the "API key" from your app at
# isthereanydeal.com, not the OAuth client ID/secret. Either set it directly or point at a file.
# ITAD_API_KEY=
# ITAD_API_KEY_FILE=/path/to/itad-api-key

# --- Session record (leave HISTORY_DIR unset to disable) ---
# Folder where the bot keeps the record of past sessions: it appends each new week to sessions.csv
# (and new games to games.csv) and keeps next.json up to date. Needs game night. The history site
# (github.com/hwfwalton/eg-history) reads the same folder. Under Docker Compose use /app/data/history.
# HISTORY_DIR=data/history
