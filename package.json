{
  "name": "eg-discord-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "start": "node src/index.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test",
    "invite": "node --env-file-if-exists=.env src/scripts/invite-url.ts",
    "lookup": "node --env-file-if-exists=.env src/scripts/lookup-game.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "croner": "^11.0.1",
    "discord.js": "^14.28.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
